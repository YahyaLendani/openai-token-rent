    "implicit": {
      "min_prefix_tokens": 1024,
      "write_multipliers": { "in_memory": 1.0, "24h": 1.0 },
      "ttl_seconds": { "in_memory": 300, "24h": 86400 },
      "max_writes_per_request": null
    }
  },
